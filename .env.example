# Copy to .env.local for local development (never commit real values).
# Supabase Dashboard → Project Settings → API (or Data API)

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Older projects: the "anon" key — use
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead. Safe to expose: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the site (used for invite links, auth redirects, social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the Privacy Policy / Terms pages
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server-only secret (sb_secret_..., older projects: service_role). Used only by
# "delete my account" to remove the login itself; without it the personal data is
# still wiped but the auth user stays. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
