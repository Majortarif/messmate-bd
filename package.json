{
  "name": "messmate-bd",
  "version": "0.1.0",
  "private": true,
  "description": "MessMate BD — the all-in-one life platform for bachelors in Dhaka: meals, wallet, bills, housing, roommates and care.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:messages": "node scripts/check-messages.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:messages",
    "db:test": "npm --prefix supabase/tests/pglite test",
    "db:types": "node supabase/tests/pglite/gen-types.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
